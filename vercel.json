{
  "version": 2,
  "experimental": {
    "functions": {
      "backend/index.py": {
        "memory": 1024,
        "maxDuration": 10
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}